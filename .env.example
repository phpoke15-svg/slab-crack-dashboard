# Which price backend to use: "ebay" (sold comps) or "pricecharting"
PRICE_SOURCE=ebay

# ── Supabase (card catalog + arbitrage cache) ──
# Create a project at https://supabase.com, then run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Pokémon TCG API (official card names, sets, photos) ──
# Free key: https://dev.pokemontcg.io/
POKEMON_TCG_API_KEY=your_pokemon_tcg_api_key

# ── eBay sold comps — SoldComps free tier: https://sold-comps.com ──
EBAY_SOLD_API_KEY=sc_your_key_here
# EBAY_SOLD_API_BASE=https://api.sold-comps.com
# Buyout Radar: cards per cron/manual run across the full catalog (default 200).
# Cursor advances each run so the whole market is covered over successive scans.
# BUYOUT_SCAN_BATCH_SIZE=200
# Do NOT set BUYOUT_SCAN_LIMIT — old chase-mode env (often 40) is ignored on purpose.

# eBay Partner Network — Campaign ID (affiliate-tagged "View on eBay" links)
# NEXT_PUBLIC_EBAY_CAMPAIGN_ID=5339164980

# eBay Developers Program — unlock Production keyset (marketplace account deletion)
# Paste this endpoint into developer.ebay.com → Notifications → Marketplace Account Deletion:
#   https://YOUR_HOST/api/ebay/marketplace-account-deletion
# EBAY_NOTIFICATION_VERIFICATION_TOKEN=32_to_80_chars_letters_numbers_underscore_hyphen
# Optional exact URL override used in the challenge hash (must match what you paste into eBay):
# EBAY_NOTIFICATION_ENDPOINT=https://collectools.app/api/ebay/marketplace-account-deletion

# PriceCharting (only needed when PRICE_SOURCE=pricecharting)
PRICECHARTING_API_KEY=your_40_character_token_here
# After running supabase/unified-card-prices.sql and the first sync-card-prices cron,
# optionally set to true to disable live PriceCharting during user search (cache only).
# Leave unset or false so search can pull live EN/JP prices from PriceCharting on demand.
# PRICING_CACHE_ONLY=true
# Optional: tune unified price sync (Vercel max 300s per run; second cron at 4 AM catches overflow)
# PRICE_SYNC_MAX_CARDS=220
# PRICE_SYNC_TIME_BUDGET_MS=260000
# Optional: full Pokemon CSV from Legendary subscription (fastest market scan)
# PRICECHARTING_CSV_PATH=data/pricecharting-pokemon.csv
# PRICECHARTING_CSV_URL=https://www.pricecharting.com/...your-csv-download-url...

# Market discovery (scans PriceCharting for slab < raw arbitrage)
DISCOVERY_LIMIT=200
DISCOVERY_MIN_RAW_PRICE=15
DISCOVERY_MIN_DEFICIT=5
DISCOVERY_ENRICH_LIMIT=300
DISCOVERY_MAX_RAW_PRICE=5000
# Only include sets released within this many years (omit / 0 / all = all time)
# DISCOVERY_MAX_SET_AGE_YEARS=all

# Optional: max chase cards for seed-top-200 (default 200)
TOP_CARDS_LIMIT=200

# Required in production — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_random_secret

# SlabCrack / SlabLab Scan — Gemini vision (2.5 Flash is fastest; 3.5 is fallback)
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# Prefer current Flash stable — gemini-2.5-flash 404s on many keys.
# GEMINI_VISION_MODEL=gemini-3.5-flash
# Optional paid OpenAI fallback (used automatically if Gemini fails):
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini
# Provider: auto (recommended) | gemini | openai
# SLABCRACK_VISION_PROVIDER=auto

# ── Site / legal (public URLs shown in Privacy & Terms) ──
# Must match the live apex→www redirect (www). Also set this in Vercel Production.
NEXT_PUBLIC_SITE_URL=https://www.collectools.app
NEXT_PUBLIC_CONTACT_EMAIL=support@collectools.app
# Optional override for the physical AMOE address shown on /giveaway-rules
# NEXT_PUBLIC_GIVEAWAY_MAILING_ADDRESS=CollecTools Monthly Giveaway, PO Box 25, Trenton, GA 30752
# Supabase Auth → URL Configuration:
#   Site URL: https://www.collectools.app
#   Redirect URLs: https://www.collectools.app/** , https://www.collectools.app/reset-password
# Optional: Google Search Console HTML tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token
# After deploy, submit https://www.collectools.app/sitemap.xml in Search Console.

# ── App store SEO (web → store discovery) ──
# App Store Connect id (default 6790246131 from eas.json)
# NEXT_PUBLIC_IOS_APP_STORE_ID=6790246131
# Comma-separated social profile URLs for Organization schema sameAs
# NEXT_PUBLIC_SOCIAL_PROFILE_URLS=https://x.com/yourhandle,https://discord.gg/yourserver
# Universal Links (server-only): Apple Developer team id
# APPLE_TEAM_ID=ABCDE12345
# Android App Links (server-only): Play signing cert SHA-256 fingerprints, comma-separated
# ANDROID_APP_LINK_SHA256=AA:BB:CC:...

# ── Billing (Stripe) ──
# Create products/prices in Stripe Dashboard, then paste price IDs:
#   Premium $4.99/mo + $39.99/yr (full SlabCrack + ad-free)
#   Pro $9.99/mo + $99.99/yr (everything including PokeWatch)
# Checkout requires STRIPE_SECRET_KEY + all four STRIPE_PRICE_* IDs.
# Webhook URL: https://YOUR_HOST/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
# Optional: dedicated secret for PokeWatch bookmarklet tokens (falls back to CRON_SECRET)
# QUEUE_WATCH_TOKEN_SECRET=your_random_secret
# Optional HTTP proxy URL for /api/check-queue canary (residential egress)
# QUEUE_CANARY_PROXY_URL=http://user:pass@host:port

# Supreme owner tier (never sold via Stripe). Comma-separated emails.
# SUPREME_EMAILS=you@example.com
# SQL: supabase/supreme-plan.sql then supabase/grant-supreme-by-email.sql

# Supreme Site Insights — Vercel Web Analytics API (production traffic on /supreme)
# Create token: Vercel → Account Settings → Tokens (read access to the project/team)
# VERCEL_ANALYTICS_TOKEN=your_vercel_access_token
# Optional overrides (auto from Vercel system env in production):
# VERCEL_ANALYTICS_PROJECT_ID=prj_...
# VERCEL_ANALYTICS_TEAM_ID=team_...

# Discord webhook for PokeWatch live alerts (optional ops channel — users get Web Push instead)
# POKEMON_CENTER_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Optional dedicated webhook for user-report alerts (falls back to PokeWatch webhook)
# REPORTS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Optional dedicated webhook for restock alerts (falls back to PokeWatch webhook)
# RESTOCKS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Optional shared secret for POST /api/restocks/report (X-Restock-Secret)
# RESTOCKS_REPORT_SECRET=your_random_secret

# ── Web Push (phone alerts for PokeWatch + Walmart Wednesday) ──
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@collectools.app
# SQL: supabase/web-push.sql
# iOS: users must Add to Home Screen, then enable alerts in Safari/PWA

# ── Restocks (Walmart Affiliate Product API) ──
# https://walmart.io/apidocs/affiliates/affiliate-marketing-api
# WALMART_AFFILIATE_CONSUMER_ID=
# WALMART_AFFILIATE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# WALMART_AFFILIATE_PUBLISHER_ID=
# WALMART_AFFILIATE_KEY_VERSION=1
# Optional: pipe-separated search queries for auto-discovery (default: ETB/bundle/box/UPC/tin)
# WALMART_DISCOVERY_QUERIES=pokemon elite trainer box|pokemon booster bundle|pokemon booster box
# Cron: /api/cron/sync-restocks daily on Hobby (once/day limit); use */15 on Pro
# Weekly Wed 9pm ET reminder: /api/cron/walmart-wednesday-reminder (uses RESTOCKS_DISCORD_WEBHOOK)
# SQL: supabase/restocks.sql (table only; Walmart SKUs auto-fill after API keys are set)
# Pokémon Center queues: use PokeWatch, not this board
# Production: set RESTOCKS_REPORT_SECRET so POST /api/restocks/report requires X-Restock-Secret
# RESTOCKS_REPORT_SECRET=your_random_secret

# ── Display ads (Google AdSense) ──
# Ads are OFF until you set this to true (after AdSense approval).
# NEXT_PUBLIC_ADS_ENABLED=true
# Apply at https://www.google.com/adsense — site must be live with real content first.
# Google AdSense — also emits <meta name="google-adsense-account" content="...">
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-8023063687308230
# CollecTools-Feed (Display, responsive) — also used as fallback for other placements
NEXT_PUBLIC_ADSENSE_FEED_SLOT_ID=7057947062
# Optional separate units (fall back to feed slot when unset):
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT_ID=
# NEXT_PUBLIC_ADSENSE_GRID_SLOT_ID=
# NEXT_PUBLIC_ADSENSE_RESULT_SLOT_ID=
# Ad density is hardcoded in lib/feed-ads.ts (feed=5, grid=8, matches=3).
# These env vars are ignored — kept here for documentation only.
# NEXT_PUBLIC_FEED_AD_INTERVAL=5
# NEXT_PUBLIC_GRID_AD_INTERVAL=8
# NEXT_PUBLIC_MATCH_AD_INTERVAL=3
