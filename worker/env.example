# IPRoyal proxy — required only when WORKER_MODE=probe (legacy Playwright poller)
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USER=
# Append geo/session flags to the password, e.g. your_password_country-us
IPROYAL_PASS=

# Legacy proxy env names (still supported for probe mode)
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USERNAME=
PROXY_PASSWORD=

# Worker mode: webhook (default) or probe (legacy browser poller)
WORKER_MODE=webhook

# HTTP port — Railway sets PORT automatically
PORT=3000

# Shared secret for POST /api/webhook/queue-alert
# Accepted via X-Webhook-Secret header, Authorization: Bearer, or ?secret=
WEBHOOK_SECRET=

# Deep link fallback when webhook payload omits dropUrl
QUEUE_DEEP_LINK=https://www.pokemoncenter.com/

# Legacy probe target (WORKER_MODE=probe only)
TARGET_URL=https://www.pokemoncenter.com/

# Firebase Admin — paste full JSON on Railway (recommended)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or local file path when JSON env var is not set
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# FCM topic broadcast target
FCM_TOPIC=pokemon_center_alerts

# OneSignal — queue-live (pro/supreme) and failure alerts (admin/supreme)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Notification dedupe cooldown between queue-live dispatches (default 15 minutes)
NOTIFICATION_COOLDOWN_MS=900000

# Worker failure alert cooldown (default 60 minutes, probe mode)
FAILURE_ALERT_COOLDOWN_MS=3600000

# Optional Upstash Redis for cross-instance cooldown + pub/sub fan-out
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NOTIFICATION_REDIS_CHANNEL=queue:detected

# Legacy alias for PORT
SUBSCRIBE_PORT=3000

# Bearer token for POST /test/queue-live (falls back to WEBHOOK_SECRET / CRON_SECRET)
WORKER_TEST_SECRET=
