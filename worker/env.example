# Proxy (residential/datacenter) — required for Imperva bypass
PROXY_HOST=proxy.example.com
PROXY_PORT=8080
PROXY_USERNAME=
PROXY_PASSWORD=

# Target to probe (HEAD only, weekdays 9 AM - 5 PM ET via cron)
TARGET_URL=https://www.pokemoncenter.com/

# Deep link included in push payload when queue goes live
QUEUE_DEEP_LINK=https://www.pokemoncenter.com/

# Firebase Admin service account JSON path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# FCM topic broadcast target
FCM_TOPIC=pokemon_center_alerts

# Optional HTTP server for mobile devices to subscribe native FCM tokens to the topic
SUBSCRIBE_PORT=8787
