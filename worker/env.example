# IPRoyal proxy (preferred names) — or use PROXY_* legacy names below
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USER=
# Append geo/session flags to the password, e.g. your_password_country-us
IPROYAL_PASS=

# Legacy proxy env names (still supported)
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USERNAME=
PROXY_PASSWORD=

# Target to probe (GET via got-scraping, weekdays 9 AM - 5 PM ET via cron)
TARGET_URL=https://www.pokemoncenter.com/

# Deep link included in push payload when queue goes live
QUEUE_DEEP_LINK=https://www.pokemoncenter.com/

# Firebase Admin — paste full JSON on Railway (recommended)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or local file path when JSON env var is not set
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# FCM topic broadcast target
FCM_TOPIC=pokemon_center_alerts

# OneSignal — admin/supreme failure alerts + optional queue-live dispatch
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Worker failure alert cooldown (default 60 minutes)
FAILURE_ALERT_COOLDOWN_MS=3600000

# Optional HTTP server for mobile devices to subscribe native FCM tokens to the topic
SUBSCRIBE_PORT=8787
