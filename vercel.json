{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/discover-arbitrage",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-binder-prices",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/sync-restocks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/walmart-wednesday-reminder",
      "schedule": "0 1,2 * * 4"
    }
  ]
}
