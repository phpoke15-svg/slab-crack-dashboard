{
  "expo": {
    "name": "CollecTools",
    "slug": "pokepax",
    "version": "1.3.13",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "collectools",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0e14"
    },
    "primaryColor": "#4ade80",
    "privacyPolicyUrl": "https://www.collectools.app/privacy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.collectools.app",
      "buildNumber": "22",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CollecTools uses the camera to photograph cards for SlabCrack Scan, SlabLab Scan, and Grade Check.",
        "NSPhotoLibraryUsageDescription": "CollecTools lets you pick card photos for SlabCrack Scan, SlabLab Scan, and Grade Check.",
        "NSUserTrackingUsageDescription": "CollecTools does not track you across apps. This permission is unused."
      }
    },
    "android": {
      "package": "com.collectools.app",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0e14"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "INTERNET"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0b0e14"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      "expo-background-fetch",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4ade80"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "36c104de-8e81-4804-86b5-5d5a0d70ae18"
      },
      "privacyPolicyUrl": "https://www.collectools.app/privacy",
      "collectoolsUrl": "https://www.collectools.app"
    },
    "owner": "phpoke15s-team"
  }
}
