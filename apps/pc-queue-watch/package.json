{
  "name": "collectools-mobile",
  "version": "1.3.10",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start",
    "android:run": "expo run:android",
    "ios": "expo start --ios",
    "ios:run": "expo run:ios",
    "build:apk": "node ./scripts/run-eas.mjs build -p android --profile apk",
    "build:preview": "node ./scripts/run-eas.mjs build -p android --profile preview",
    "build:android": "node ./scripts/run-eas.mjs build -p android --profile production",
    "build:ios": "node ./scripts/run-eas.mjs build -p ios --profile production",
    "build:ios:preview": "node ./scripts/run-eas.mjs build -p ios --profile preview",
    "submit:android": "node ./scripts/run-eas.mjs submit -p android --profile production --latest",
    "submit:ios": "node ./scripts/run-eas.mjs submit -p ios --profile production --latest",
    "generate:assets": "node scripts/generate-brand-icons.mjs",
    "verify:assets": "node scripts/verify-assets.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.30",
    "expo-asset": "~11.0.5",
    "expo-background-fetch": "~13.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-keep-awake": "~14.0.2",
    "expo-linking": "~7.0.4",
    "expo-notifications": "~0.29.13",
    "expo-status-bar": "~2.0.1",
    "expo-task-manager": "~12.0.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
