    "migrate-poke-to-pokemon-ids": "npx tsx scripts/migrate-poke-to-pokemon-ids.ts",
    "migrate-poke-to-pokemon-ids:apply": "npx tsx scripts/migrate-poke-to-pokemon-ids.ts --apply",
