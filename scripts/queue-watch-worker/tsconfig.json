{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/lib/*": ["../../lib/*"]
    }
  },
  "include": ["src/**/*.ts", "../../lib/pokemon-center/**/*.ts"]
}
